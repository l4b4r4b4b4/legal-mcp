# Ignore raw XML corpus (too large for git, use Git LFS or separate repo)
raw/

# Ignore processed data (can be regenerated)
processed/

# Embedding JSONL files are tracked via Git LFS (see .gitattributes).
# The manifest is small JSON and tracked in regular git.
# Only ignore if you want to exclude locally-generated files not yet in LFS.

# Keep directory structure
!.gitkeep

# Ignore any temporary files
*.tmp
*.bak
